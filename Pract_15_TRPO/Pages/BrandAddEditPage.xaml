<Page x:Class="Pract_15_TRPO.Pages.BrandAddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract_15_TRPO.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница Добавления изменения Бренда"
      xmlns:conv ="clr-namespace:Pract_15_TRPO.Converters"
      xmlns:valid ="clr-namespace:Pract_15_TRPO.ValidationRules">
    <Page.Resources>
        <valid:RequaredRule x:Key="RequaredRule"/>
        <conv:ValidationConvertor x:Key="ValidationConverter"/>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="24" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center">Добавление/Изменение Бренда</TextBlock>

        <TextBlock FontSize="24" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">Название Бренда</TextBlock>
        <TextBox Grid.Row="1" x:Name="name" Grid.Column="1" FontSize="24">
            <TextBox.Text >
                <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                            <valid:RequaredRule ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
        <Button Margin="10" Grid.Row="2" VerticalContentAlignment="Bottom" VerticalAlignment="Bottom" Click="Save" Content="Сохранить" >
            <Button.IsEnabled>
                <MultiBinding Converter="{StaticResource ValidationConverter}">
                    <Binding ElementName="name" Path="(Validation.HasError)" />
                </MultiBinding>
            </Button.IsEnabled>
        </Button>
        <Button Margin="10" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Bottom" VerticalAlignment="Bottom" Click="Back" >Назад</Button>
    </Grid>
</Page>
