<Page x:Class="Pract_15_TRPO.Pages.TagsProductAdd"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract_15_TRPO.Pages"
      xmlns:m ="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TagsProductAdd">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <ComboBox m:HintAssist.Hint="Выберите Тэг" ItemsSource="{Binding Tags}" DisplayMemberPath="Name" SelectedIndex="0" SelectedItem="{Binding SelectedTag}"/>
            <Button Content="Добавить" Click="Add_Click"/>
            <Button Content="Убрать Тэг" Click="Remove_Click"/>
            <Button Content="Назад" Click="Back_Click"/>
        </StackPanel>

        <ListView Margin="10" Grid.Column="1" ItemsSource="{Binding ProductTags}" SelectedItem="{Binding SelectedProdTag}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Label Content="{Binding Tag.Name}" FontSize="20"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
