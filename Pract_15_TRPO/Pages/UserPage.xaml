<Page x:Class="Pract_15_TRPO.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract_15_TRPO.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:conv="clr-namespace:Pract_15_TRPO.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Title="Каталог товаров"
      Background="Transparent"
      >
    <Page.Resources>
        <conv:ProductTagsToStringConverter  x:Key="ProductTagsToStringConverter"/>
        <conv:ProductCountConvertor x:Key="ProductCount"/>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1">
            <Label>Поиск</Label>
            <TextBox Text="{Binding searchQuery, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Введите текст для поиска" TextChanged="TextBox_TextChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1">
                <StackPanel Margin="10,0,0,0">
                    <Label>Фильтрация По Бренду</Label>
                <TextBox Text="{Binding searchQueryBrand, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Введите текст для поиска" TextChanged="TextBox_TextChanged"/>
                </StackPanel>
            <StackPanel Margin="10,0,0,0" >
                <Label>Фильтрация По категории</Label>
                <TextBox Text="{Binding searchQueryCategory, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Введите текст для поиска" TextChanged="TextBox_TextChanged"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Cursor="">
            <StackPanel>
                <Label FontSize="16">Фильтр по цене</Label>
                <Label>от</Label>
                <TextBox  Text="{Binding filterPriceFrom,UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Введите цену" TextChanged="TextBox_TextChanged"/>
                <Label>до</Label>
                <TextBox Text="{Binding filterPriceTo,UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Введите цену" TextChanged="TextBox_TextChanged"/>
            </StackPanel>
            <Label FontSize="16">Сортировка</Label>
            <ComboBox SelectionChanged="ComboBox_SelectionChanged">
                <ComboBox.Items>
                    <ComboBoxItem Tag="All">Ничего</ComboBoxItem>
                    <ComboBoxItem Tag="Name">По Имени</ComboBoxItem>
                    <ComboBoxItem Tag="PriceDown">По Цене(убывание)</ComboBoxItem>
                    <ComboBoxItem Tag="PriceUp">По Цене(возрастание)</ComboBoxItem>
                    <ComboBoxItem Tag="CountDown">По Колличеству(убывание)</ComboBoxItem>
                    <ComboBoxItem Tag="CountUp">По Колличеству(возрастанию)</ComboBoxItem>
                </ComboBox.Items>
            </ComboBox>
        </StackPanel>
        <materialDesign:ColorZone Grid.Row="1" Grid.Column="1" Mode="SecondaryMid">
            <ListView ItemsSource="{Binding products}" Name="FormsList" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate >
                        <Border BorderThickness="2" >
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{Binding Stock,Converter={StaticResource ProductCount}}"/>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.RowSpan="6" Grid.Column="0">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock>
                             <Run Text="⭐"/>
                             <Run Text="{Binding Rating}"/>
                                    </TextBlock>
                                    <TextBlock>
                                    <Run Text="{Binding Category.Name}"/>
                                    </TextBlock>
                                    <TextBlock>
                                    <Run Text="{Binding Description}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2">
                                    <Run Text="{Binding ProductTags,Converter={StaticResource ProductTagsToStringConverter}}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="0">
                                    <TextBlock HorizontalAlignment="Right">
                             <Run Text="Цена: "/>
                             <Run Text="{Binding Price, StringFormat={}{0:C}}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="4" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right">
                             <Run Text="Остаток "/>
                             <Run Text="{Binding Stock}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </materialDesign:ColorZone>
        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2">
            <TextBlock Text="{Binding products.Count, StringFormat='{}Всего Товаров:{0}'}"/>
            <TextBlock Text="{Binding Items.Count, ElementName=FormsList,StringFormat='{} Показано: {0}'}"/>
        </WrapPanel>
    </Grid>
</Page>
